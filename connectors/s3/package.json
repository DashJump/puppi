{
  "name": "@puppi/adapter-s3",
  "version": "0.1.1",
  "description": "Parquet tables and files on S3-compatible storage (AWS, MinIO, R2), signed with SigV4 over fetch.",
  "homepage": "https://github.com/DashJump/puppi",
  "bugs": {
    "url": "https://github.com/DashJump/puppi/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DashJump/puppi.git",
    "directory": "connectors/s3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@puppi/adapter-storage": "workspace:*",
    "@puppi/sdk": "workspace:*"
  },
  "devDependencies": {
    "@puppi/conformance": "workspace:*",
    "@types/node": "^26.6.5",
    "rolldown": "^1.2.8",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=26"
  }
}
