{
  // `pnpm generate` writes src/openapi.ts from the vendor schema. That file
  // is not hand-edited, and its unions trip no-redundant-type-constituents.
  "extends": ["../../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["src/openapi.ts"],
      "rules": {
        "typescript/no-redundant-type-constituents": "off"
      }
    }
  ]
}
