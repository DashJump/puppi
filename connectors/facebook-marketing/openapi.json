{
  "openapi": "3.0.3",
  "info": {
    "title": "Facebook Marketing API campaigns",
    "version": "v27.0",
    "description": "GET /{account} and GET /{account}/campaigns for Marketing API v27.0. Meta publishes no OpenAPI document for this version; https://github.com/facebook/openapi contains the WhatsApp Business API only. Account fields follow the Graph API Reference v27.0 ad account (https://developers.facebook.com/docs/graph-api/reference/ad-account/). Campaign fields id, name, status, and updated_time are the Campaign node (https://developers.facebook.com/docs/marketing-api/reference/ad-campaign-group/). The version is a prefix of the base URL (/<version>), not a path in this document. A campaign edge returns only id unless fields is set."
  },
  "servers": [{ "url": "https://graph.facebook.com/v27.0" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <access_token>. The token is never a query parameter."
      }
    },
    "schemas": {
      "Campaign": {
        "type": "object",
        "required": ["id", "name", "status", "updated_time"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "updated_time": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/{account}/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Ad account id, act_ prefixed once."
          },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "after", "in": "query", "schema": { "type": "string" } },
          {
            "name": "fields",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Campaign fields to return. Omitted, the edge returns only id."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of campaigns.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Campaign" }
                    },
                    "paging": {
                      "type": "object",
                      "properties": {
                        "cursors": {
                          "type": "object",
                          "properties": {
                            "after": { "type": "string" }
                          }
                        },
                        "next": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{account}": {
      "get": {
        "operationId": "getAccount",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Ad account id, act_ prefixed once."
          }
        ],
        "responses": {
          "200": {
            "description": "The ad account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
