{
  "name": "puppi",
  "private": true,
  "description": "TypeScript packages for Puppi pipelines.",
  "homepage": "https://github.com/DashJump/puppi",
  "bugs": {
    "url": "https://github.com/DashJump/puppi/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DashJump/puppi.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run --filter '!puppi' build",
    "publish:dry-run": "node .github/scripts/publish-packages.mjs --dry-run",
    "publish:packages": "node .github/scripts/publish-packages.mjs",
    "test": "node --test .github/scripts/publish-packages.test.mjs && vp run --filter '!puppi' test",
    "typecheck": "tsc -p tsconfig.json --noEmit && vp run --filter '!puppi' typecheck",
    "lint": "vp lint --deny-warnings",
    "lint:types": "vp lint --type-aware --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "deadcode": "knip --production",
    "check": "vp run lint && vp run lint:types && vp run format:check && vp run typecheck"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.14",
    "@changesets/cli": "^3.0.3",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/node": "^26.6.5",
    "knip": "^6.45.1",
    "typescript": "^5.6.3",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
