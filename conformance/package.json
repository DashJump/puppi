{
  "name": "@puppi/conformance",
  "version": "0.1.0",
  "private": true,
  "description": "Checks a storage adapter against the object-store contract, and an HTTP source against its declaration and its pinned OpenAPI document.",
  "homepage": "https://github.com/DashJump/puppi",
  "bugs": {
    "url": "https://github.com/DashJump/puppi/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DashJump/puppi.git",
    "directory": "conformance"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vp test run --config ../vite.config.ts"
  },
  "dependencies": {
    "@puppi/adapter-storage": "workspace:*",
    "@puppi/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.3",
    "vite-plus": "catalog:"
  }
}
